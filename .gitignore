# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Virtual environments
venv/
.venv/
env/

# Linting / formatting cache
.ruff_cache/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Logs
*.log
logs/*
!logs/.gitkeep

# Environment / secrets
.env
.env.*
config/settings.json
config/*.swp

# Results (large data files)
results/*.json
results/*.csv

# Cloned data repos
internet-scanners/

# IDE files
.vscode/
.idea/
*.code-workspace

# OS files
.DS_Store
Thumbs.db

# Vim swap files
*.swp
*.swo
*~
